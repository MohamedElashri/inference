<!--
#######################################################
# SUMMARY OF THIS TEST
# ...................
# Author: Daniel Craik
# Purpose: Test the large-event passthrough pathway
#          by setting the GPU memory allocation to zero
#######################################################
-->
<extension class="GaudiTest.GaudiExeTest" kind="test">
  <argument name="program"><text>python</text></argument>
  <argument name="args"><set>
    <text>${BINARYDUMPERSROOT}/options/allen.py</text>
    <text>--test-file-db-key</text><text>upgrade_Sept2022_minbias_0fb_md_mdf</text>
    <text>--sequence</text><text>${ALLEN_INSTALL_DIR}/constants/hlt1_pp_matching.json</text>
    <text>--events-per-slice</text><text>500</text>
    <text>-m</text><text>0</text>
    <text>-s</text><text>1</text>
    <text>-t</text><text>1</text>
    <text>-n</text><text>2</text>
    <text>--output-file</text><text>large_event_passthrough.mdf</text>
  </set></argument>
  <argument name="reference"><text>../refs/allen_large_event_passthrough.ref</text></argument>
  <argument name="error_reference"><text>../refs/empty.ref</text></argument>
  <argument name="timeout"><integer>600</integer></argument>
  <argument name="use_temp_dir"><enumeral>true</enumeral></argument>
  <argument name="validator"><text>

from Allen.qmtest.exclusions import preprocessor, skip_lbdd4hep
validateWithReference(preproc = preprocessor)

countErrorLines({"FATAL":0,"ERROR":0,"WARNING":0}, stdout=skip_lbdd4hep(stdout))

  </text></argument>
</extension>
