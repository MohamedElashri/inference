<!--
#######################################################
# SUMMARY OF THIS TEST
# ...................
# Author: Roel Aaij
# Purpose: Decode the large-event passthrough event
#          to check that it is consistenct with expectations
#######################################################
-->
<extension class="GaudiTest.GaudiExeTest" kind="test">
  <argument name="program"><text>gaudirun.py</text></argument>
  <argument name="args"><set>
    <text>$ALLENROOT/tests/options/large_event_output.py</text>
    <text>$ALLENROOT/tests/options/hlt1_decoding.py</text>
  </set></argument>
  <argument name="prerequisites"><set>
    <tuple><text>large_event_passthrough</text><enumeral>PASS</enumeral></tuple>
  </set></argument>
  <argument name="use_temp_dir"><enumeral>true</enumeral></argument>
  <argument name="validator"><text>

from Allen.qmtest.validators import check_large_event_histograms

countErrorLines({"FATAL": 0, "ERROR": 0, "WARNING": 0})

line_name, pass_counts, rb_counts = check_large_event_histograms("large_event_passthrough.root")
result['pass_counts'] = str(pass_counts)
result['rb_counts'] = str(rb_counts)
result['line_name'] = line_name

if list(pass_counts.values()) != [2]:
    causes.append("Pass counts {} are not [2] as expected".format(rb_counts))

if rb_counts != {26: 2}:
    causes.append("Routing bit counts {} are not [(26, 2)] as expected".format(rb_counts))

  </text></argument>
</extension>
